    "@capacitor/cli": "8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.5.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.30",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
