{
  "name": "InventorySystem",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "dev:full": "concurrently --kill-others --names API,WEB --prefix-colors green,cyan \"npm --prefix backend run start:dev\" \"npm run dev\"",
    "build": "ng build",
    "build:full": "npm --prefix backend run build && npm run build",
    "test:full": "npm --prefix backend test && npm test -- --watch=false",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "22.1.7",
