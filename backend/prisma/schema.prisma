generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ItemCategory {
  CONSUMABLE
  NON_CONSUMABLE
}

enum InventoryRoleType {
  USER
  ADMIN
  SUPERADMIN
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE_OUT
  COUNT_IN
  COUNT_OUT
}

model InventoryRole {
  id             Int               @id @default(autoincrement())
  employeeNumber String            @unique @db.VarChar(32)
  roleType       InventoryRoleType
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model InventoryItem {
  id                  Int                 @id @default(autoincrement())
  itemName            String              @db.VarChar(255)
  description         String?             @db.Text
  brand               String?             @db.VarChar(120)
  category             ItemCategory
  purchaseUom         String              @db.VarChar(80)
  distributionUom     String              @db.VarChar(80)
  conversionFactor    Decimal             @db.Decimal(12, 3)
  reorderLevel        Decimal             @default(0) @db.Decimal(18, 6)
  status              InventoryItemStatus @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  balance             InventoryBalance?
  movements           InventoryMovement[]
  physicalCounts      PhysicalInventoryCount[]
  stockEntries        StockItem[]

  @@index([itemName])
  @@index([category, status])
}

model InventoryBalance {
  id        Int           @id @default(autoincrement())
  itemId    Int           @unique
  quantity  Decimal       @default(0) @db.Decimal(18, 6)
  updatedAt DateTime      @updatedAt
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
}

model InventoryMovement {
  id                  Int                    @id @default(autoincrement())
  itemId              Int
  employeeNumber      String                 @db.VarChar(32)
  employeeName        String?                @db.VarChar(255)
  movementType        InventoryMovementType
  quantityEntered     Decimal                @db.Decimal(18, 6)
  enteredUom          String                 @db.VarChar(80)
  conversionFactor    Decimal                @db.Decimal(12, 3)
  quantityBase        Decimal                @db.Decimal(18, 6)
  balanceAfter        Decimal                @db.Decimal(18, 6)
  note                String?                @db.VarChar(500)
  createdAt           DateTime               @default(now())
  item                InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([employeeNumber, createdAt])
}

model PhysicalInventorySession {
  id             Int                         @id @default(autoincrement())
  employeeNumber String                      @db.VarChar(32)
  note           String?                     @db.VarChar(500)
  createdAt      DateTime                    @default(now())
  counts         PhysicalInventoryCount[]

  @@index([createdAt])
}

model PhysicalInventoryCount {
  id             Int                      @id @default(autoincrement())
  sessionId      Int
  itemId         Int
  expected       Decimal                  @db.Decimal(18, 6)
  counted        Decimal                  @db.Decimal(18, 6)
  variance       Decimal                  @db.Decimal(18, 6)
  createdAt      DateTime                 @default(now())
  session        PhysicalInventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item           InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, itemId])
  @@index([itemId, createdAt])
}

model StockItem {
  id              Int          @id @default(autoincrement())
  stockNumber     String       @unique @db.VarChar(32)
  barcode         String       @unique @db.Char(10)
  itemName        String       @db.VarChar(255)
  category        ItemCategory
  unitOfMeasurement String     @db.VarChar(80)
  brand           String?      @db.VarChar(120)
  quantity        Decimal      @db.Decimal(12, 3)
  expirationDate  DateTime?    @db.Date
  reorderLevel    Decimal      @db.Decimal(12, 3)
  itemId          Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  item            InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemName])
  @@index([category])
  @@index([itemId])
}

model StockInSequence {
  year     Int @id
  sequence Int @default(0)
}
